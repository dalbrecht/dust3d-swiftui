+    // Experimental local-core acceptance: solid chart colors cannot distinguish selected LOD.
+    func testExperimentalNativeMixedMipProductionRender() async throws {
+        guard let device = MTLCreateSystemDefaultDevice() else { throw XCTSkip("No Metal device is available") }
+        let options = SourceMeshBakeOptions(
+            bake: MeshBakeOptions(colorSize: 256, normalSize: 256, materialSize: 256, atlasTextureSize: 256,
+                maximumMetadataPayloadBytes: 16 * 1024 * 1024, maximumBakePayloadBytes: 16 * 1024 * 1024),
+            maximumSamplerPayloadBytes: 16 * 1024 * 1024, maximumAtlasPayloadBytes: 16 * 1024 * 1024,
+            maximumNativePayloadBytes: 32 * 1024 * 1024, maximumChartCount: 100,
+            maximumRasterSamples: 10_000_000, maximumMipLevels: 8)
+        let source = try MeshLoader.loadSourceBaked(data: mixedMipArchive(), options: options)
+        XCTAssertEqual(source.modelIDs.count, 1)
+        XCTAssertTrue(source.triangles.contains { $0.modelIndex == nil })
+        XCTAssertTrue(source.triangles.contains { $0.modelIndex == 0 })
+        XCTAssertTrue(source.triangles.allSatisfy { $0.packedUVs != nil && $0.policy != nil })
+        XCTAssertGreaterThanOrEqual(source.maximumSamplingLod, 1)
+        let chain = try XCTUnwrap(source.mipmaps.color)
+        XCTAssertGreaterThanOrEqual(chain.levels.count, 2)
+        XCTAssertLessThanOrEqual(chain.levels.count, 8)
+        XCTAssertEqual(chain.maximumSamplingLod, source.maximumSamplingLod)
+        XCTAssertLessThan(source.maximumSamplingLod, Double(chain.levels.count))
+        let savedLevels = chain.levels.map { [UInt8]($0.pixels) }
+        _ = try MeshLoader.loadSourceBaked(data: mixedMipArchive(), options: options)
+        XCTAssertEqual(chain.levels.map { [UInt8]($0.pixels) }, savedLevels)
+        // The triangle normal is proportional to (+1,-1,0). An oblique view
+        // retains both its face and the fixture's horizontal component separation.
+        let camera = OrbitCamera(yaw: -.pi / 4, pitch: -.pi / 4, distance: 3)
+        guard source.triangles.count <= Int.max / 3,
+            source.geometry.vertices.count == source.triangles.count * 3
+        else {
+            XCTFail("Source geometry must contain three vertices per triangle")
+            return
+        }
+        let bounds = try RenderBounds(vertices: source.geometry.vertices)
+        func projectedBounds(imported: Bool) throws -> (minX: Int, maxX: Int, minY: Int, maxY: Int) {
+            var points: [SIMD2<Float>] = []
+            for (index, triangle) in source.triangles.enumerated() where (triangle.modelIndex != nil) == imported {
+                for corner in 0..<3 {
+                    let position = source.geometry.vertices[index * 3 + corner].position
+                    let normalized = (position - bounds.center) / bounds.radius
+                    let clip = camera.transform(aspect: 1) * SIMD4(normalized, 1)
+                    guard clip.w > 0 else { throw RendererError.unavailable("Fixture projects behind camera") }
+                    points.append(SIMD2((clip.x / clip.w + 1) * 64, (1 - clip.y / clip.w) * 64))
+                }
+            }
+            let first = try XCTUnwrap(points.first)
+            let minimum = points.reduce(first) { simd_min($0, $1) }
+            let maximum = points.reduce(first) { simd_max($0, $1) }
+            return (max(0, Int(floor(minimum.x))), min(127, Int(ceil(maximum.x))),
+                    max(0, Int(floor(minimum.y))), min(127, Int(ceil(maximum.y))))
+        }
+        let blueRegion = try projectedBounds(imported: true)
+        let redRegion = try projectedBounds(imported: false)
+        XCTAssertTrue(blueRegion.maxX < redRegion.minX || redRegion.maxX < blueRegion.minX,
+                      "Projected source regions must be disjoint")
+        let owner = try await TexturedMetalResourcesBuilder().make(bakedMesh: source, device: device, camera: camera)
+        let texture = owner.textures[0]
+        guard texture.mipmapLevelCount == chain.levels.count else {
+            XCTFail("Metal texture level count must equal the retained chain")
+            return
+        }
+        for (index, level) in chain.levels.enumerated() {
+            var bytes = [UInt8](repeating: 0, count: level.pixels.count)
+            texture.getBytes(&bytes, bytesPerRow: level.rowStride,
+                from: MTLRegionMake2D(0, 0, level.width, level.height), mipmapLevel: index)
+            XCTAssertEqual(Data(bytes), level.pixels, "Uploaded color mip \(index) must match owned native output")
+        }
+        let output = try await pixels(TexturedMeshRenderer(resources: owner), device: device)
+        func containsColor(_ region: (minX: Int, maxX: Int, minY: Int, maxY: Int), channel: Int) -> Bool {
+            guard region.minX <= region.maxX, region.minY <= region.maxY else { return false }
+            for y in region.minY...region.maxY {
+                for x in region.minX...region.maxX {
+                    let offset = (y * 128 + x) * 4
+                    if output[offset + 3] == 255 && output[offset + channel] > output[offset + (2 - channel)]
+                        && output[offset + channel] > output[offset + 1] { return true }
+                }
+            }
+            return false
+        }
+        XCTAssertTrue(containsColor(redRegion, channel: 2), "Opaque red in projected tube region")
+        XCTAssertTrue(containsColor(blueRegion, channel: 0), "Opaque blue in projected imported region")
+    }
